# Copy to .env in this directory (not committed to git).
#
# Option A — local Mongo via monorepo Docker:
#   docker compose up -d   (from monorepo root)  →  MONGO_URI=mongodb://127.0.0.1:27017
#
# Option B — use the same cluster as other services in this monorepo:
#   Copy MONGO_URI (and adjust DB_NAME if needed) from:
#   services/payments/.env.development  or  services/utils/.env.development

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.dfxf3ml.mongodb.net/?retryWrites=true&w=majority
DB_NAME=serveaso
PORT=3001
