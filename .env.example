# Copy to .env in this directory (not committed to git).
#
# Option A — local Mongo via monorepo Docker:
#   docker compose up -d   (from monorepo root)  →  MONGO_URI=mongodb://127.0.0.1:27017
#
# Option B — use the same cluster as other services in this monorepo:
#   Copy MONGO_URI from services/payments/.env.development or services/utils/.env.development
#   DB_NAME below is the MongoDB database name (Postgres uses POSTGRES_DB in .env.local).

MONGO_URI=mongodb://serveaso:serveaso@98.130.50.75:27017/?authSource=admin
DB_NAME=serveaso
PORT=3001
