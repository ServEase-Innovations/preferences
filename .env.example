# Copy to .env in this directory (not committed to git).
#
# Option A — local Mongo via monorepo Docker:
#   docker compose up -d   (from monorepo root)  →  MONGO_URI=mongodb://127.0.0.1:27017
#
# Option B — shared cluster: set MONGO_URI in your private .env (copy from team secrets, not from git)
#   DB_NAME below is the MongoDB database name (Postgres uses POSTGRES_DB in .env.local).

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=serveaso
PORT=3001
